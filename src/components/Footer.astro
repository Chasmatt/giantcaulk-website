---
interface Props {
  theme?: "light" | "dark";
}
const { theme = "dark" } = Astro.props;
const textColor = theme === "light" ? "text-white/75 border-white/20" : "text-navy/70 border-navy/10";
---

<footer class={`mt-16 border-t ${textColor}`}>
  <div class="mx-auto flex max-w-[1600px] items-center justify-center gap-4 px-4 py-6 md:px-8 text-xs font-body tracking-wide uppercase">
    <span>&copy; 2026 Giant Caulk</span>
  </div>
</footer>
