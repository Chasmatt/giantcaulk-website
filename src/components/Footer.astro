---
interface Props {
  theme?: "light" | "dark";
}
const { theme = "dark" } = Astro.props;
const textColor = theme === "light" ? "text-white/75 border-white/20" : "text-navy/70 border-navy/10";
const linkColor = theme === "light" ? "hover:text-white" : "hover:text-navy";
---

<footer class={`mt-16 border-t ${textColor}`}>
  <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-4 py-6 md:px-8 text-xs font-body tracking-wide uppercase">
    <span>&copy; 2026 Giant Caulk</span>
    {/* TODO placeholder: real phone number */}
    <span><a href="tel:+13172601079" class={`transition-colors ${linkColor}`}>(317) 260-1079</a></span>
    <span>Licensed, bonded &amp; insured</span>
  </div>
</footer>
