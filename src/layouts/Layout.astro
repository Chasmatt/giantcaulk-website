---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  navTheme?: "light" | "dark";
  footerTheme?: "light" | "dark";
  bodyClass?: string;
}
const {
  title,
  description = "Commercial caulking, joint sealing, and sealant restoration — expansion joints, curtain wall perimeters, precast panel joints, installed to spec.",
  navTheme = "dark",
  footerTheme = "dark",
  bodyClass = "",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#132A4A" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">Skip to content</a>
  <Nav theme={navTheme} />
  <main id="main">
    <slot />
  </main>
  <Footer theme={footerTheme} />
</body>
</html>
