---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us | Giant Caulk"
  description="Request a quote for commercial caulking, joint sealing, and leak detection. Attach blueprints and we'll reply within one business day."
  navTheme="light"
  footerTheme="light"
  bodyClass="has-desk-bg"
>
  {/* Desk photo shows at full strength — nav is white so it stays legible over
      the wood grain at the top. The phone in the photo shows the contact info,
      so no sidebar needed. */}
  <style>
    body.has-desk-bg {
      background-image: url("/images/hero-desk.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }
    @media (max-width: 700px) {
      body.has-desk-bg {
        background-image: url("/images/hero-desk-mobile.jpg");
        background-attachment: scroll;
      }
    }
  </style>

  <section class="px-4 md:px-8 py-8 md:py-12 max-w-[1400px] mx-auto">
    {/* Form floats on the LEFT half of the page so the phone in the background
        photo (with owner + phone + email displayed) stays visible on the right.
        On smaller screens the card widens to fill the viewport. */}
    <div class="max-w-full md:max-w-[560px] lg:max-w-[620px] md:mr-auto">

      <div class="rounded-2xl bg-white shadow-2xl shadow-navy/25 overflow-hidden">
        <div class="p-6 md:p-10">
          <h1 class="font-serif text-4xl md:text-5xl font-bold text-navy mb-3">
            Contact Us
          </h1>
          <p class="font-body text-base md:text-lg text-navy/75 mb-6 max-w-[52ch] leading-relaxed">
            Whether it&rsquo;s leak detection or leak prevention, we keep the
            elements out. Contact us today for your sealing needs.
          </p>

          {/* Steel bead divider — signature detail from the design system. */}
          <div class="h-[3px] w-full bg-steel rounded-full mb-8"></div>

          {/*
            FormSubmit handles delivery — free tier, sends notification emails
            directly to the address in the `action` URL. First submission from
            this site triggers a one-time activation email to giantcaulk@outlook.com
            that must be confirmed before subsequent submissions are delivered.

            Hidden config fields (all start with underscore):
              - _next          full URL to redirect to after successful submit
              - _subject       email subject line
              - _template=table renders form fields as a clean table in the email
              - _captcha=false skip FormSubmit's captcha (we have a honeypot)
              - _honey         honeypot field — if filled, submission is dropped

            The email input MUST stay name="email" so FormSubmit sets Reply-To.
          */}
          <form
            method="POST"
            action="https://formsubmit.co/giantcaulk@outlook.com"
            enctype="multipart/form-data"
            class="space-y-5"
          >
            <input type="hidden" name="_next" value="https://giantcaulk.netlify.app/thanks/" />
            <input type="hidden" name="_subject" value="New quote request — Giant Caulk website" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />

            <p class="hidden">
              <label>Leave this field empty
                <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
              </label>
            </p>

            <div class="field">
              <label for="company" class="field-label">Company Name</label>
              <input
                type="text" id="company" name="company"
                autocomplete="organization" required
                enterkeyhint="next"
                class="field-input"
              />
            </div>

            <div class="field">
              <label for="name" class="field-label">Contact Name</label>
              <input
                type="text" id="name" name="name"
                autocomplete="name" required
                enterkeyhint="next"
                class="field-input"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="field">
                <label for="email" class="field-label">Contact Email</label>
                <input
                  type="email" id="email" name="email"
                  autocomplete="email" required
                  enterkeyhint="next" inputmode="email"
                  class="field-input"
                />
              </div>

              <div class="field">
                <label for="phone" class="field-label">Contact Phone</label>
                <input
                  type="tel" id="phone" name="phone"
                  autocomplete="tel" required
                  enterkeyhint="next" inputmode="tel"
                  class="field-input"
                />
              </div>
            </div>

            <div class="field">
              <label for="comments" class="field-label">
                Comments <span class="text-concrete-500 font-normal normal-case tracking-normal">&mdash; building type, address, and scope of work</span>
              </label>
              <textarea
                id="comments" name="comments" rows="6" required
                enterkeyhint="next"
                placeholder="e.g. Six-storey precast office building, 400 Business Parkway. Approx. 3,200 LF of vertical panel joints, existing sealant failing. Looking for full removal and replacement."
                class="field-input resize-y min-h-[9rem]"
              ></textarea>
            </div>

            {/* Blueprint upload — accepts common construction file types. */}
            <div class="field">
              <label for="blueprints" class="field-label inline-flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                Attach Blueprints
                <span class="text-concrete-500 font-normal normal-case tracking-normal">&mdash; PDF, JPG, PNG, DWG, TIF (optional)</span>
              </label>
              <input
                type="file" id="blueprints" name="blueprints"
                accept=".pdf,.jpg,.jpeg,.png,.dwg,.dxf,.tif,.tiff,image/*,application/pdf"
                multiple
                class="field-input file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-steel file:text-white file:font-body file:font-semibold file:cursor-pointer hover:file:bg-steel-deep"
              />
            </div>

            <div class="flex justify-center pt-2">
              <button type="submit" class="btn-primary w-full sm:w-auto">
                Submit <span aria-hidden="true">&rarr;</span>
              </button>
            </div>

            <p class="font-body text-xs text-concrete-500 mt-4 text-center">
              We reply to every request within one business day. Emergency leak or active water intrusion? Call instead.
            </p>
          </form>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Form field styling — one place, so every input renders the same. */
  .field-label {
    display: block;
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #132A4A;
    margin-bottom: 0.4rem;
    font-weight: 600;
  }
  .field-input {
    width: 100%;
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-size: 1rem;            /* ≥ 16px so iOS Safari doesn't zoom on focus */
    color: #132A4A;
    background: #EEF2F6;
    border: 1px solid #C3CFDA;
    border-bottom-width: 3px;
    border-radius: 6px;
    padding: 0.7rem 0.9rem;
    transition: background-color 140ms ease, border-color 140ms ease;
  }
  .field-input::placeholder { color: #8698AA; }
  .field-input:hover { background: #E7EDF3; }
  .field-input:focus {
    outline: none;
    background: #FFF;
    border-color: #3E6491;
    border-bottom-color: #2C4A6E;
  }
  .field-input:focus-visible {
    outline: 2px solid #3E6491;
    outline-offset: 2px;
  }
  .field-input:user-invalid {
    border-color: #B23A2F;
  }
</style>
